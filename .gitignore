# Dependencies and build output — never commit these (a repo pushed from a
# generated app carried 31,559 node_modules files without this file).
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# Secrets: .env holds the app's ByteFlow API key (VITE_BYTEFLOW_API_KEY).
.env
.env.*
!.env.example

# Logs, editor and OS clutter
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Platform bookkeeping inside the sandbox
.byteflow/

# Secrets (auto-added by ByteFlow push)
.env.local
